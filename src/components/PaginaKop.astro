---
interface Props {
  titel: string;
  lead?: string;
}
const { titel, lead } = Astro.props;
---
<section class="container pagina-kop">
  <h1>{titel}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</section>

<style>
  .pagina-kop {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  h1 {
    font-size: clamp(2.5rem, 1.3rem + 4.4vw, 4.5rem);
    line-height: 1.02;
    max-width: 16ch;
    margin-bottom: 1.25rem;
  }
  .lead {
    max-width: var(--maat);
  }
</style>
