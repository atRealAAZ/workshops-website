---
/**
 * Drie stemkaarten die omhoog gaan, in de kleuren van de drie workshops.
 * Handen omhoog is in elke workshop het moment waarop de zaal meedoet.
 */
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="5" y="7" width="11" height="17" rx="1.5" fill="#0e7c66" transform="rotate(-16 10.5 28)" />
  <rect x="10.5" y="5" width="11" height="17" rx="1.5" fill="#3a3f9e" />
  <rect x="16" y="7" width="11" height="17" rx="1.5" fill="#d9381e" transform="rotate(16 21.5 28)" />
</svg>
