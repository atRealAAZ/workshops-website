---
import Base from '../../layouts/Base.astro';
import WorkshopCover from '../../components/WorkshopCover.astro';
import Afsluiter from '../../components/Afsluiter.astro';
import { workshops, type Workshop } from '../../data/workshops';
import { site } from '../../config';
import { cursus, kruimelpad } from '../../data/schema';

export function getStaticPaths() {
  return workshops.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

const { w } = Astro.props as { w: Workshop };
const anderen = workshops.filter((x) => x.slug !== w.slug);
const totaal = w.programma.reduce((s, b) => s + b.minuten, 0);
const doenMinuten = w.programma.filter((b) => b.doen).reduce((s, b) => s + b.minuten, 0);
const planHref = `/contact/?workshop=${w.slug}`;
---
<Base
  titel={w.seoTitel}
  beschrijving={w.seoBeschrijving}
  schema={[
    cursus(w),
    kruimelpad([
      { naam: 'Home', pad: '/' },
      { naam: 'Workshops', pad: '/workshops/' },
      { naam: w.titel, pad: `/workshops/${w.slug}/` },
    ]),
  ]}
>
  <div class={`toon-${w.tone}`}>
    <section class="kop-band op-kleur" aria-labelledby="titel">
      <div class="container kop-grid">
        <div class="kop-tekst">
          <nav aria-label="Kruimelpad" class="kruimel">
            <ol>
              <li><a href="/">Home</a></li>
              <li><a href="/workshops/">Workshops</a></li>
              <li aria-current="page">{w.titel}</li>
            </ol>
          </nav>
          <h1 id="titel">{w.titelAfbreken ?? w.titel}</h1>
          <p class="vraag">{w.vraag}</p>
          <p class="ondertitel">{w.ondertitel}</p>
          <div class="knoppen">
            <a class="knop" href={planHref}>Plan {w.titel}</a>
            <a class="knop knop-tweede" href="#programma">Bekijk het programma</a>
          </div>
        </div>
        <WorkshopCover tone={w.tone} achtergrond={false} class="kop-beeld" />
      </div>
    </section>

    <div class="container">
      <dl class="feiten feitenpaneel">
        {w.feiten.map((f) => (
          <div><dt>{f.label}</dt><dd>{f.waarde}</dd></div>
        ))}
        <div><dt>Opstelling</dt><dd>{w.tafels}</dd></div>
        <div><dt>Thema</dt><dd>{w.themas.join(', ')}</dd></div>
      </dl>
    </div>

    <div class="container inhoud">
      <article class="hoofd">
        <section aria-labelledby="doen-titel">
          <h2 id="doen-titel">Wat ga je doen?</h2>
          <div class="leesmaat verhaal">
            {w.verhaal.map((p, i) => <p class={i === 0 ? 'lead' : undefined}>{p}</p>)}
          </div>
        </section>

        <section id="programma" aria-labelledby="programma-titel">
          <h2 id="programma-titel">Programma</h2>
          <p class="programma-intro">
            {totaal} minuten, waarvan {doenMinuten} minuten zelf doen en praten.
          </p>

          <div class="avond" aria-hidden="true">
            {w.programma.map((b) => (
              <span class:list={['segment', { doen: b.doen }]} style={`flex-grow:${b.minuten}`}></span>
            ))}
          </div>
          <p class="legenda" aria-hidden="true">
            <span><i class="stip doen"></i>Zelf doen en praten</span>
            <span><i class="stip"></i>Luisteren en kijken</span>
          </p>

          <ol class="tijdlijn">
            {w.programma.map((b) => (
              <li class:list={{ doen: b.doen }}>
                <span class="tijd">{b.start}</span>
                <div>
                  <h3>{b.titel}</h3>
                  <p class="meta">
                    {b.minuten} minuten, {b.doen ? 'zelf doen en praten' : 'luisteren en kijken'}
                  </p>
                  <p>{b.tekst}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section aria-labelledby="mee-titel">
          <h2 id="mee-titel">Wat neem je mee naar huis?</h2>
          <ul class="streeplijst leesmaat">
            {w.meenemen.map((m) => <li>{m}</li>)}
          </ul>
        </section>

        <section aria-labelledby="niet-titel">
          <h2 id="niet-titel">Wat het niet is</h2>
          <ul class="streeplijst leesmaat niet">
            {w.niet.map((m) => <li>{m}</li>)}
          </ul>
        </section>
      </article>

      <aside class="zijkant" aria-labelledby="nodig-titel">
        <div class="zijkant-binnen">
          <h2 id="nodig-titel">Wat is er nodig?</h2>
          <ul class="streeplijst">
            {w.nodig.map((n) => <li>{n}</li>)}
          </ul>
          <a class="knop" href={planHref}>Plan {w.titel}</a>
          <p class="mail">
            Liever eerst mailen? <a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(w.titel)}`}>{site.contactEmail}</a>
          </p>
        </div>
      </aside>
    </div>

    <section class="sectie aankondiging" aria-labelledby="aankondiging-titel">
      <div class="container aankondiging-grid">
        <div>
          <h2 id="aankondiging-titel">Zo kondig je hem aan</h2>
          <p class="toelichting">
            Een tekst voor je programma, nieuwsbrief of website. Neem hem over zoals hij is, of pas hem aan.
          </p>
          <button class="knop knop-tweede kopieer" type="button" data-doel="aankondiging-tekst">
            Kopieer de tekst
          </button>
          <p class="kopieer-status" role="status" aria-live="polite"></p>
        </div>
        <div class="aankondiging-tekst" id="aankondiging-tekst">
          <p class="aankondiging-titel">Workshop: {w.titel}</p>
          {w.aankondiging.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  </div>

  <section class="sectie" aria-labelledby="anderen-titel">
    <div class="container">
      <div class="sectie-kop">
        <h2 id="anderen-titel">De andere twee workshops</h2>
        <p>Samen vormen ze een reeks: wat zie je online, kun je het geloven, en hoe beslissen we samen?</p>
      </div>
      <ul class="anderen">
        {anderen.map((a) => (
          <li class={`toon-${a.tone}`}>
            <a href={`/workshops/${a.slug}/`}>
              <span class="ander-vraag">{a.vraag}</span>
              <span class="ander-titel">{a.titel}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Afsluiter
    titel={`${w.titel} in jullie zaal?`}
    tekst="Vertel wie je publiek is, waar en wanneer. Dan kijken we samen of en hoe het past."
    knop={`Plan ${w.titel}`}
    href={planHref}
  />
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.kopieer').forEach((knop) => {
    const status = knop.parentElement?.querySelector('.kopieer-status');
    knop.addEventListener('click', async () => {
      const doel = document.getElementById(knop.dataset.doel ?? '');
      if (!doel) return;
      const tekst = Array.from(doel.querySelectorAll('p'))
        .map((p) => p.textContent?.trim())
        .join('\n\n');
      try {
        await navigator.clipboard.writeText(tekst);
        knop.textContent = 'Tekst gekopieerd';
        if (status) status.textContent = 'De aankondiging staat op je klembord.';
      } catch {
        if (status) status.textContent = 'Kopiëren lukte niet. Selecteer de tekst en kopieer hem zelf.';
      }
      setTimeout(() => {
        knop.textContent = 'Kopieer de tekst';
      }, 2500);
    });
  });
</script>

<style>
  /* --- Kop ----------------------------------------------------------- */
  .kop-band {
    background: var(--toon);
    color: var(--papier);
    padding-bottom: 5rem;
    overflow: hidden;
  }
  .kop-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
  }
  .kop-tekst {
    padding-block: 2rem 1rem;
  }
  .kruimel ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding: 0;
    font-size: var(--t-klein);
  }
  .kruimel li + li::before {
    content: '/';
    margin-right: 0.4rem;
    opacity: 0.7;
  }
  .kruimel a {
    color: inherit;
  }
  .kop-band h1 {
    font-size: clamp(2.25rem, 1.2rem + 3vw, 3.5rem);
    font-stretch: 110%;
    line-height: 1.04;
    hyphens: manual;
  }
  .vraag {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 600;
    font-size: clamp(1.3125rem, 1rem + 1.2vw, 1.75rem);
    line-height: 1.25;
  }
  .ondertitel {
    margin-block: 1rem 2rem;
    max-width: 32rem;
  }
  .kop-beeld {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    margin-right: calc(var(--rand) * -1);
  }

  .feitenpaneel {
    position: relative;
    margin-top: -3rem;
    background: var(--roze);
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .feitenpaneel dd {
    text-wrap: balance;
  }
  @media (max-width: 40rem) {
    .feitenpaneel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* --- Inhoud -------------------------------------------------------- */
  .inhoud {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    gap: 3rem clamp(2rem, 1rem + 4vw, 5rem);
    padding-block: var(--sectie);
  }
  .hoofd > section + section {
    margin-top: clamp(3.5rem, 3rem + 2vw, 5rem);
  }
  .hoofd h2 {
    margin-bottom: 1.5rem;
  }
  .verhaal p + p {
    margin-top: 1.1em;
  }

  .programma-intro {
    color: var(--inkt-zacht);
    margin-bottom: 1.25rem;
  }
  .avond {
    display: flex;
    gap: 3px;
    height: 1.25rem;
  }
  .segment {
    background: color-mix(in srgb, var(--toon) 28%, white);
  }
  .segment.doen {
    background: var(--toon);
  }
  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
    font-size: var(--t-klein);
    color: var(--inkt-zacht);
  }
  .stip {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    margin-right: 0.45rem;
    vertical-align: -0.05em;
    background: color-mix(in srgb, var(--toon) 28%, white);
  }
  .stip.doen {
    background: var(--toon);
  }

  .tijdlijn {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .tijdlijn li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.25rem 0 1.25rem 1.25rem;
    border-left: 4px solid color-mix(in srgb, var(--toon) 28%, white);
  }
  .tijdlijn li.doen {
    border-left-color: var(--toon);
  }
  .tijd {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: var(--t-h3);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .tijdlijn h3 {
    margin-bottom: 0.2rem;
  }
  .meta {
    font-size: var(--t-klein);
    color: var(--inkt-zacht);
    margin-bottom: 0.5rem;
  }
  .tijdlijn .meta + p {
    margin-top: 0;
    max-width: 34rem;
  }

  .niet li::before {
    background: var(--inkt-zacht);
  }

  .zijkant-binnen {
    position: sticky;
    top: 1.5rem;
    border-top: 4px solid var(--toon);
    padding-top: 1.5rem;
  }
  .zijkant h2 {
    font-size: var(--t-h3);
    margin-bottom: 1.25rem;
  }
  .zijkant .streeplijst {
    margin-bottom: 2rem;
    font-size: var(--t-klein);
  }
  .zijkant .knop {
    width: 100%;
  }
  .mail {
    margin-top: 1rem;
    font-size: var(--t-klein);
    color: var(--inkt-zacht);
    overflow-wrap: anywhere;
  }

  /* --- Aankondiging -------------------------------------------------- */
  .aankondiging {
    background: #f4f3f8;
  }
  .aankondiging-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 2rem 4rem;
    align-items: start;
  }
  .toelichting {
    margin-block: 1rem 1.5rem;
    color: var(--inkt-zacht);
    max-width: 26rem;
  }
  .kopieer-status {
    margin-top: 0.75rem;
    font-size: var(--t-klein);
    min-height: 1.5em;
  }
  .aankondiging-tekst {
    background: var(--papier);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-left: 6px solid var(--toon);
    max-width: 44rem;
  }
  .aankondiging-titel {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: var(--t-h3);
    margin-bottom: 1rem;
  }

  /* --- Anderen ------------------------------------------------------- */
  .anderen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .anderen a {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    height: 100%;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    background: var(--toon);
    color: var(--papier);
    text-decoration: none;
  }
  .anderen a:focus-visible {
    outline: 4px solid var(--inkt);
    outline-offset: 3px;
  }
  .ander-vraag {
    font-family: var(--font-display);
    font-stretch: var(--breed);
    font-weight: 800;
    font-size: var(--t-h2);
    line-height: 1.08;
  }
  .ander-titel {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 54rem) {
    .kop-grid,
    .inhoud,
    .aankondiging-grid,
    .anderen {
      grid-template-columns: 1fr;
    }
    .kop-beeld {
      max-height: 14rem;
      margin-right: 0;
    }
    .zijkant-binnen {
      position: static;
    }
  }
</style>
