---
import Base from '../layouts/Base.astro';
import PaginaKop from '../components/PaginaKop.astro';
---
<Base titel="Pagina niet gevonden" nietIndexeren>
  <PaginaKop titel="Deze pagina bestaat niet" lead="Misschien is hij verhuisd, of zit er een typfout in het adres.">
    <div class="knoppen">
      <a class="knop" href="/">Naar de homepage</a>
      <a class="knop knop-tweede" href="/workshops/">Bekijk de workshops</a>
    </div>
  </PaginaKop>
  <div style="padding-bottom: var(--sectie)"></div>
</Base>
