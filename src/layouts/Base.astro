---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';

interface Props {
  titel?: string;
  beschrijving?: string;
}
const {
  titel,
  beschrijving = 'Drie interactieve workshops van 90 minuten over informatiebubbels, nepnieuws en democratie. Voor bibliotheken, gemeenten, scholen en organisaties.',
} = Astro.props;
const volledigeTitel = titel ? `${titel} | ${site.name}` : `${site.name}: ${site.tagline.toLowerCase()}`;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{volledigeTitel}</title>
    <meta name="description" content={beschrijving} />
    <meta property="og:title" content={volledigeTitel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="overslaan" href="#inhoud">Naar de inhoud</a>
    <Header />
    <main id="inhoud">
      <slot />
    </main>
    <Footer />
  </body>
</html>
